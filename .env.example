# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the web app (used for CSRF origin checks and CORS).
# Leave empty in development to accept the request host.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon connection string (Project -> Dashboard -> Connect).
# Use the *pooled* connection string for serverless/short-lived runtimes.
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# When DATABASE_URL is empty the API uses an embedded PGlite database for
# local development. Data lives in this directory (never commit it).
PGLITE_DIR=.local/pglite

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Session lifetime in days. Sessions are stored hashed in Postgres.
SESSION_TTL_DAYS=7
# Force the Secure cookie flag. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=

# ---------------------------------------------------------------------------
# Development seed (used by `pnpm db:seed` only)
# ---------------------------------------------------------------------------
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed once.
SEED_ADMIN_EMAIL=admin@coaching.local
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Web app (apps/web/.env.local)
# ---------------------------------------------------------------------------
# Only needed when the API is hosted on a different origin than the web app.
# VITE_API_URL=https://your-api-host.example.com
