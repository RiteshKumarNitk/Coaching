# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the web app (used for CSRF origin checks and CORS).
# Leave empty in development to accept the request host.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon connection string (Project -> Dashboard -> Connect).
# Use the *pooled* connection string for serverless/short-lived runtimes.
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb
DATABASE_URL=

# TLS mode for the Postgres connection. The API resolves this itself: it strips
# sslmode= from DATABASE_URL and sets the pg `ssl` option explicitly.
#   verify-full  default for any non-local host: encrypted, certificate chain and
#                hostname verified. Use this for Neon, Supabase, RDS, managed hosts.
#   require / prefer / verify-ca / allow
#                aliases for verify-full, as pg-connection-string v2 treats them today.
#   no-verify    encrypted, certificate not verified (self-signed certificate).
#   disable      no TLS: a loopback database or a self-hosted server on a private
#                network with no TLS configured.
# sslmode= in DATABASE_URL is still honoured when DATABASE_SSL is empty.
DATABASE_SSL=

# When DATABASE_URL is empty the API uses an embedded PGlite database for
# local development. Data lives in this directory (never commit it).
PGLITE_DIR=.local/pglite

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Session lifetime in days. Sessions are stored hashed in Postgres.
SESSION_TTL_DAYS=7
# Force the Secure cookie flag. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=

# Set to true when TLS is terminated by nginx/Caddy/a load balancer, so req.ip
# is the real client address and per-IP rate limits work per user.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Development seed (used by `pnpm db:seed` only)
# ---------------------------------------------------------------------------
# If SEED_ADMIN_PASSWORD is empty a random password is generated and printed once.
SEED_ADMIN_EMAIL=admin@coaching.local
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Web app (apps/web/.env.local)
# ---------------------------------------------------------------------------
# Only needed when the API is hosted on a different origin than the web app.
# VITE_API_URL=https://your-api-host.example.com
